# Copy this file to .env and fill in real values. Nothing here is a working default —
# the app will refuse to start if JWT_SECRET or DB credentials are missing.

PORT=3000

# Redis - holds ONLY ephemeral rate-limit counters. Losing this data is not
# catastrophic (limits just reset), which is why it's not the source of truth
# for API keys.
REDIS_URL=redis://localhost:6379

# MySQL - source of truth for users and API key configs (limit, window, algorithm).
DB_HOST=localhost
DB_PORT=3306
DB_USER=ratelimiter_app
DB_PASSWORD=
DB_NAME=rate_limiter_gateway

# Used to sign admin JWTs. Generate a real random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime
JWT_EXPIRES_IN=1h
